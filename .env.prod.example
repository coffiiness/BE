# Copy to .env.prod on the Oracle VM and chmod 600 .env.prod.
# Blank secrets must be supplied before Compose config/up can succeed.
# Use single quotes around values containing $ to avoid Compose interpolation.
# Do not commit .env.prod or publish `docker compose config` output.

BACKEND_IMAGE=calfit-backend:oracle-arm64
API_BIND_PORT=8080
API_HEALTH_START_PERIOD=120s

# Fresh MySQL 8.4.13 DB for portfolio/demo; AWS DB data is not imported.
# Create once: docker volume create calfit_oracle_mysql84
# Never set this to an old 8.0 volume. Existing volumes must remain untouched.
MYSQL_VOLUME_NAME=calfit_oracle_mysql84
MYSQL_DATABASE=calfit
MYSQL_USER=calfit_app
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=30000
# Default validate. A NEW empty 8.4 DB uses a one-command update override once.
JPA_DDL_AUTO=validate

# Generate distinct random values locally, e.g. openssl rand -base64 64.
JWT_SECRET=
CALENDAR_GOOGLE_WATCH_TOKEN_SECRET=

# Origins only: no trailing slash or /api/v1. Use a stable production Pages URL.
PUBLIC_API_BASE_URL=https://api.example.com
PUBLIC_FRONTEND_BASE_URL=https://replace-with-your-project.pages.dev
CORS_ALLOWED_ORIGINS=https://replace-with-your-project.pages.dev

JAVA_OPTS=-Xms256m -Xmx768m
TOMCAT_THREADS_MAX=100
TOMCAT_THREADS_MIN_SPARE=10

# Existing S3 integration is preserved, not migrated to R2 in this change.
# Supply least-privilege AWS credentials or a supported workload identity setup.
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_APPLICANT_BUCKET=replace-with-your-existing-s3-bucket
S3_KEY_PREFIX=uploads
PRESIGN_EXPIRE_MINUTES=10

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# Enable only after SMTP and sender/link settings have been verified.
# Signup/invitation emails will not be delivered while this is false.
APP_EMAIL_ENABLED=false
APP_EMAIL_SENDER=no-reply@example.com
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_SMTP_STARTTLS_REQUIRED=true
SPRING_MAIL_SMTP_SSL_ENABLE=false
SPRING_MAIL_SMTP_SSL_PROTOCOLS=TLSv1.2
SPRING_MAIL_SMTP_SSL_TRUST=
SPRING_MAIL_SMTP_CONNECTION_TIMEOUT=5000
SPRING_MAIL_SMTP_TIMEOUT=5000
SPRING_MAIL_SMTP_WRITE_TIMEOUT=5000
