# Docker
DOCKER_USERNAME=your_dockerhub_username

# MySQL Container
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=calfit
MYSQL_USER=calfit
MYSQL_PASSWORD=your_mysql_password

# Grafana
GRAFANA_ADMIN_PASSWORD=your_grafana_password

# Email app settings
APP_EMAIL_ENABLED=true
APP_EMAIL_SENDER=your_email_account  # set same as SPRING_MAIL_USERNAME for Gmail/Naver
APP_EMAIL_API_BASE_URL=http://localhost:8080
APP_EMAIL_FRONTEND_BASE_URL=http://localhost:5173

# SMTP (Gmail default example)
# Naver example:
#   SPRING_MAIL_HOST=smtp.naver.com
#   SPRING_MAIL_PORT=465
#   SPRING_MAIL_SMTP_STARTTLS_ENABLE=false
#   SPRING_MAIL_SMTP_STARTTLS_REQUIRED=false
#   SPRING_MAIL_SMTP_SSL_ENABLE=true
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email_account
SPRING_MAIL_PASSWORD=your_app_password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_SMTP_STARTTLS_REQUIRED=true
SPRING_MAIL_SMTP_SSL_ENABLE=false
SPRING_MAIL_SMTP_CONNECTION_TIMEOUT=5000
SPRING_MAIL_SMTP_TIMEOUT=5000
SPRING_MAIL_SMTP_WRITE_TIMEOUT=5000
